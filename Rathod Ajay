
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My First Website</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f8f3e9;
      color: #244b3c;
    }

    header {
      padding: 20px;
      background: #244b3c;
      color: white;
      text-align: center;
    }

    main {
      max-width: 700px;
      margin: 60px auto;
      padding: 24px;
      text-align: center;
    }

    h1 {
      font-size: clamp(32px, 7vw, 52px);
    }

    button {
      padding: 14px 22px;
      border: 0;
      border-radius: 8px;
      background: #d87556;
      color: white;
      font-size: 16px;
      cursor: pointer;
    }
  </style>
</head>
<body>
  <header>My First Website</header>

  <main>
    <h1>Welcome to My Website</h1>
    <p>I am learning website development with AI.</p>
    <button onclick="showMessage()">Click Me</button>
    <p id="message"></p>
  </main>

  <script>
    function showMessage() {
      document.getElementById("message").textContent =
        "Congratulations! Your first interaction works.";
    }
  </script>
</body>
</html>

